# BestTime.app foot-traffic API keys — https://besttime.app/signup (free test key).
# The private key creates forecasts, the public key refreshes them cheaply.
# Both stay on the server; the browser never receives them.
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=

# Crowd Assistant (any OpenAI-compatible chat completions API).
# Defaults to Z.ai's endpoint and glm-4-flash; set these to use another provider.
AI_API_KEY=
# AI_BASE_URL=https://api.z.ai/api/paas/v4
# AI_MODEL=glm-4.5-flash
# GLM reasons by default (~30s per reply); thinking is disabled automatically.
# AI_THINKING=on

# Optional overrides
PORT=8787
# How long a fetched forecast is reused before asking BestTime again.
CROWD_CACHE_TTL_MINUTES=720
# Optional: point the server at a different API base (tests, proxies).
# BESTTIME_API_BASE=https://besttime.app/api/v1
